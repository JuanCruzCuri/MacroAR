# ============================================
# MacroAR - Variables de Entorno
# ============================================

# Database (PostgreSQL)
# Para Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Para Neon: postgresql://user:password@host/dbname
# Para local: postgresql://postgres:postgres@localhost:5432/macroar
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/macroar

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Scraping (daily at 18:00 ART)
SCRAPE_DAY_OF_WEEK=*
SCRAPE_HOUR=18
SCRAPE_MINUTE=0
SCRAPE_TIMEZONE=America/Argentina/Buenos_Aires

# Production Frontend URL (ej: Vercel)
# FRONTEND_URL=https://macroar.vercel.app
